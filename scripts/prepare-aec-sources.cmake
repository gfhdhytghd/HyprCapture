# Pre-seed every CPU TFLite dependency from the same manifest used by Nix.
# No upstream FetchContent/ExternalProject download is needed after this step.
cmake_minimum_required(VERSION 3.19)
file(READ "${MANIFEST}" manifest)
file(MAKE_DIRECTORY "${CACHE}/archives" "${CACHE}/pinned-sources")

function(unpack name archive digest)
  set(source "${CACHE}/pinned-sources/${name}-${digest}")
  if(NOT EXISTS "${source}/.verified")
    file(REMOVE_RECURSE "${source}.part" "${source}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${source}.part")
    file(GLOB roots LIST_DIRECTORIES TRUE "${source}.part/*")
    list(LENGTH roots count)
    if(NOT count EQUAL 1 OR NOT IS_DIRECTORY "${roots}")
      message(FATAL_ERROR "Unexpected archive layout for ${name}")
    endif()
    file(RENAME "${roots}" "${source}")
    file(REMOVE_RECURSE "${source}.part")
    file(WRITE "${source}/.verified" "${digest}\n")
  endif()
  set(${name}_source "${source}" PARENT_SCOPE)
endfunction()

set(init "${CACHE}/pinned-sources.cmake")
file(WRITE "${init}" "set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL \"\" FORCE)\n")
string(JSON count LENGTH "${manifest}")
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
  foreach(field name url sha256)
    string(JSON ${field} GET "${manifest}" ${index} ${field})
  endforeach()
  set(archive "${CACHE}/archives/${name}-${sha256}")
  set(actual "")
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" actual)
  endif()
  if(NOT actual STREQUAL sha256)
    if(OFFLINE)
      message(FATAL_ERROR "Missing checksum-verified archive: ${name}")
    endif()
    file(DOWNLOAD "${url}" "${archive}.part" EXPECTED_HASH "SHA256=${sha256}"
      TLS_VERIFY ON TIMEOUT 600 STATUS result)
    list(GET result 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "Cannot download ${name}: ${result}")
    endif()
    file(RENAME "${archive}.part" "${archive}")
  endif()
  unpack("${name}" "${archive}" "${sha256}")
  string(TOUPPER "${name}" upper)
  file(APPEND "${init}" "set(FETCHCONTENT_SOURCE_DIR_${upper} [==[${${name}_source}]==] CACHE PATH \"\" FORCE)\n")
  # XNNPACK and TFLite use separate ExternalProject downloads for these.
  if(name MATCHES "^(fp16|fxdiv|pthreadpool|psimd|cpuinfo)$")
    file(APPEND "${init}" "set(${upper}_SOURCE_DIR [==[${${name}_source}]==] CACHE PATH \"\" FORCE)\n")
  endif()
endforeach()
